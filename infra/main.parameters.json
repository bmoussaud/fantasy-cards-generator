{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "deployerPrincipalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "deployerPrincipalType": {
      "value": "${AZURE_PRINCIPAL_TYPE}"
    },
    "deployEntraAppRegistration": {
      "value": "${deployEntraAppRegistration}"
    },
    "legacyCosmosIpRule": {
      "value": "${LEGACY_COSMOS_IP_RULE=}"
    },
    "appSessionSecretKeyValue": {
      "value": "${APP_SESSION_SECRET_KEY=}"
    },
    "entraClientSecretValue": {
      "value": "${ENTRA_CLIENT_SECRET=}"
    }
  }
}
