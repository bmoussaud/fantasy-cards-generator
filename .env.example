APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
TELEMETRY_ENABLED=false
OTEL_SERVICE_NAME=fantasy-cards-generator
TELEMETRY_SAMPLING_RATIO=1.0
APPLICATIONINSIGHTS_CONNECTION_STRING=
APP_SESSION_SECRET_KEY=change-me-to-a-long-random-value
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_AUTHORITY=https://login.microsoftonline.com/organizations/v2.0
ENTRA_REDIRECT_URI=https://localhost:8000/auth/callback
ENTRA_POST_LOGOUT_REDIRECT_URI=https://localhost:8000/
ENTRA_SCOPES=openid profile email
AI_MODE=mock
PERSISTENCE_MODE=memory
FOUNDRY_ENDPOINT=
FOUNDRY_API_VERSION=2025-03-01-preview
FOUNDRY_TEXT_DEPLOYMENT=gpt-5-5
FOUNDRY_IMAGE_DEPLOYMENT=gpt-image-2
COSMOS_ENDPOINT=
COSMOS_DATABASE_NAME=appdb
COSMOS_CONTAINER_NAME=cards
BLOB_ENDPOINT=
BLOB_CONTAINER_NAME=card-assets
MODERATION_SERVICE=heuristic
MODERATION_POLICY_NAME=conservative-v1
RATE_LIMIT_USER_REQUESTS=6
RATE_LIMIT_USER_WINDOW_SECONDS=60
RATE_LIMIT_IP_REQUESTS=12
RATE_LIMIT_IP_WINDOW_SECONDS=60
TRUSTED_PROXY_HOPS=0
UPSTREAM_MAX_RETRIES=2
IMAGE_MAX_RETRIES=0
UPSTREAM_BASE_BACKOFF_SECONDS=0.15
TEXT_TIMEOUT_SECONDS=20
IMAGE_TIMEOUT_SECONDS=150
OVERALL_TIMEOUT_SECONDS=225
AUDIT_RETENTION_DAYS=30
IMAGE_SIZE=1024x1024
IMAGE_QUALITY=low
