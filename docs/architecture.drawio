<mxfile host="app.diagrams.net" type="device">
  <diagram id="image-generation" name="Generation image - appels et composants">
    <mxGraphModel dx="2340" dy="1820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2340" pageHeight="1820" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="g-title" value="Génération d'une image | composants et appels" style="text;html=0;align=left;fontSize=34;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="2260" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="g-subtitle" value="FastAPI (pas Flask) : les agents préparent la carte et le prompt ; le backend WEB demande ensuite les pixels au modèle d'image." style="text;html=0;align=left;fontSize=23;fontColor=#42526E;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="2260" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="g-legend" value="Bleu plein : appels locaux / enchaînement   |   Violet pointillé : HTTPS vers l'IA   |   Orange : résultat distant   |   Vert : stockage / restitution" style="text;html=0;align=left;fontSize=21;fontColor=#42526E;" vertex="1" parent="1">
          <mxGeometry x="40" y="155" width="2260" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="g-client" value="CLIENT" style="rounded=0;dashed=1;fillColor=#F0F5FA;strokeColor=#61758A;fontColor=#263B50;align=left;verticalAlign=top;spacing=18;fontSize=23;fontStyle=1;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="280" height="1460" as="geometry"/>
        </mxCell>
        <mxCell id="g-web" value="WEB | Azure Container Apps" style="rounded=0;dashed=1;fillColor=#EFF7FF;strokeColor=#377CB6;fontColor=#174D77;align=left;verticalAlign=top;spacing=18;fontSize=23;fontStyle=1;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="400" y="220" width="520" height="1460" as="geometry"/>
        </mxCell>
        <mxCell id="g-hosted" value="HOSTED | card-orchestrator" style="rounded=0;dashed=1;fillColor=#F6F0FC;strokeColor=#8651B0;fontColor=#592C7A;align=left;verticalAlign=top;spacing=18;fontSize=23;fontStyle=1;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="1020" y="220" width="650" height="1110" as="geometry"/>
        </mxCell>
        <mxCell id="g-models" value="MODÈLES | Azure OpenAI / Foundry" style="rounded=0;dashed=1;fillColor=#FFF6EB;strokeColor=#B07829;fontColor=#704913;align=left;verticalAlign=top;spacing=18;fontSize=23;fontStyle=1;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="1770" y="220" width="500" height="1110" as="geometry"/>
        </mxCell>
        <mxCell id="g-data" value="DONNÉES | accès par le backend, endpoints privés" style="rounded=0;dashed=1;fillColor=#EFF8F0;strokeColor=#4C8A59;fontColor=#2C6337;align=left;verticalAlign=top;spacing=18;fontSize=23;fontStyle=1;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="1020" y="1420" width="1250" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="g-browser" value="1. Navigateur&#10;Jinja2 + HTMX&#10;Prompt + photo&#10;facultative" style="shape=label;rounded=0;fillColor=#E4EDF7;strokeColor=#40699A;fontColor=#172B4D;fontSize=21;align=center;verticalAlign=top;spacingTop=52;imageAlign=center;imageVerticalAlign=top;imageWidth=34;imageHeight=34;image=https://tomkiljo.github.io/ms-icons/icons/Azure_Public_Service_Icons/Icons/general/10783-icon-service-Browser.svg;" vertex="1" parent="g-client">
          <mxGeometry x="20" y="70" width="240" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="g-client-note" value="Session authentifiée&#10;+ protection CSRF&#10;&#10;Aucun appel direct&#10;du navigateur&#10;aux agents, modèles&#10;ou blobs privés." style="text;html=0;align=center;fontSize=21;fontColor=#42526E;" vertex="1" parent="g-client">
          <mxGeometry x="20" y="420" width="240" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="g-display" value="9. Affichage&#10;Carte + image PNG" style="shape=label;rounded=0;fillColor=#E2F0D9;strokeColor=#4C8A59;fontColor=#213E27;fontSize=21;align=center;verticalAlign=top;spacingTop=52;imageAlign=center;imageVerticalAlign=top;imageWidth=34;imageHeight=34;image=https://tomkiljo.github.io/ms-icons/icons/Azure_Public_Service_Icons/Icons/general/10783-icon-service-Browser.svg;" vertex="1" parent="g-client">
          <mxGeometry x="20" y="1330" width="240" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="g-api" value="FastAPI / Uvicorn (port 8000)&#10;POST /ui/cards/generate&#10;ou POST /api/v1/cards/generate" style="shape=label;rounded=0;fillColor=#BCDDF7;strokeColor=#286BA2;fontColor=#102D46;fontSize=21;align=center;verticalAlign=top;spacingTop=52;imageAlign=center;imageVerticalAlign=top;imageWidth=34;imageHeight=34;image=https://tomkiljo.github.io/ms-icons/icons/Azure_Public_Service_Icons/Icons/other/02884-icon-service-Worker-Container-App.svg;" vertex="1" parent="g-web">
          <mxGeometry x="30" y="70" width="460" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="g-service" value="2. CardGenerationService&#10;Auth / quotas / idempotence&#10;Modération du prompt (locale)&#10;Orchestration applicative, pas un LLM" style="rounded=0;fillColor=#CDE3FA;strokeColor=#377CB6;fontColor=#172B4D;fontSize=21;align=center;verticalAlign=middle;" vertex="1" parent="g-web">
          <mxGeometry x="30" y="250" width="460" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="g-http-client" value="FoundryAgentClient + httpx&#10;Responses : input_text (JSON)&#10;store=false / stream=false&#10;Jeton Entra ; photo non transmise" style="rounded=0;fillColor=#D9EAFB;strokeColor=#377CB6;fontColor=#172B4D;fontSize=21;align=center;verticalAlign=middle;" vertex="1" parent="g-web">
          <mxGeometry x="30" y="440" width="460" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="g-web-gate" value="6. Résultat HOSTED validé&#10;Carte + artPrompt, status=completed&#10;Modération texte + prompt artistique" style="rounded=0;fillColor=#CDE3FA;strokeColor=#377CB6;fontColor=#172B4D;fontSize=21;align=center;verticalAlign=middle;" vertex="1" parent="g-web">
          <mxGeometry x="30" y="665" width="460" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="g-image-client" value="7. AzureFoundryAIClient + httpx&#10;Sans photo : images/generations (JSON)&#10;Avec photo : images/edits (multipart)&#10;artPrompt + taille + qualité" style="rounded=0;fillColor=#D9EAFB;strokeColor=#377CB6;fontColor=#172B4D;fontSize=20;align=center;verticalAlign=middle;" vertex="1" parent="g-web">
          <mxGeometry x="30" y="850" width="460" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="g-persist" value="8. Contrôle image + persistance&#10;Modération après génération&#10;Réservation Cosmos ; upload Blob&#10;Puis carte + métadonnées dans Cosmos" style="rounded=0;fillColor=#D5EBD9;strokeColor=#4C8A59;fontColor=#213E27;fontSize=20;align=center;verticalAlign=middle;" vertex="1" parent="g-web">
          <mxGeometry x="30" y="1090" width="460" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="g-proxy" value="Réponse HTML / JSON + URL privée&#10;GET /cards/{card_id}/image&#10;Contrôle propriétaire ; proxy Blob" style="rounded=0;fillColor=#E2F0D9;strokeColor=#4C8A59;fontColor=#213E27;fontSize=20;align=center;verticalAlign=middle;" vertex="1" parent="g-web">
          <mxGeometry x="30" y="1330" width="460" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="g-host" value="3. ResponsesAgentServerHost (8088)&#10;StatelessBoundary → CardOrchestrator&#10;Un service hébergé, distinct du WEB" style="shape=label;rounded=0;fillColor=#E7D3F7;strokeColor=#8651B0;fontColor=#38214B;fontSize=21;align=center;verticalAlign=top;spacingTop=52;imageAlign=center;imageVerticalAlign=top;imageWidth=34;imageHeight=34;image=https://tomkiljo.github.io/ms-icons/icons/Azure_Public_Service_Icons/Icons/ai%20+%20machine%20learning/03513-icon-service-AI-Studio.svg;" vertex="1" parent="g-hosted">
          <mxGeometry x="30" y="70" width="580" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="g-workflow" value="WorkflowBuilder → WorkflowAgent&#10;Graphe neuf par requête ; décodage + pré-contrôle&#10;AgentExecutor pilote chaque Agent MAF" style="rounded=0;fillColor=#E4D9F5;strokeColor=#8651B0;fontColor=#38214B;fontSize=21;align=center;verticalAlign=middle;" vertex="1" parent="g-hosted">
          <mxGeometry x="30" y="250" width="580" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="g-concept" value="4a. AgentExecutor → Agent card_concept&#10;Crée la carte structurée&#10;FoundryChatClient → SDK OpenAI Responses" style="shape=label;rounded=0;fillColor=#E7D3F7;strokeColor=#8651B0;fontColor=#38214B;fontSize=19;align=center;verticalAlign=top;spacingTop=40;imageAlign=center;imageVerticalAlign=top;imageWidth=30;imageHeight=30;image=https://tomkiljo.github.io/ms-icons/icons/Azure_Public_Service_Icons/Icons/ai%20+%20machine%20learning/10165-icon-service-Bot-Services.svg;" vertex="1" parent="g-hosted">
          <mxGeometry x="30" y="400" width="580" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="g-lore" value="4b. AgentExecutor → Agent card_lore&#10;Enrichit name / flavorText de la carte validée&#10;Même client et même modèle texte" style="shape=label;rounded=0;fillColor=#EBDCF7;strokeColor=#8651B0;fontColor=#38214B;fontSize=19;align=center;verticalAlign=top;spacingTop=40;imageAlign=center;imageVerticalAlign=top;imageWidth=30;imageHeight=30;image=https://tomkiljo.github.io/ms-icons/icons/Azure_Public_Service_Icons/Icons/ai%20+%20machine%20learning/10165-icon-service-Bot-Services.svg;" vertex="1" parent="g-hosted">
          <mxGeometry x="30" y="565" width="580" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="g-art" value="4c. AgentExecutor → Agent card_art_direction&#10;Enrichit artBrief de la carte validée&#10;Produit du texte, pas des pixels" style="shape=label;rounded=0;fillColor=#E4D9F5;strokeColor=#8651B0;fontColor=#38214B;fontSize=19;align=center;verticalAlign=top;spacingTop=40;imageAlign=center;imageVerticalAlign=top;imageWidth=30;imageHeight=30;image=https://tomkiljo.github.io/ms-icons/icons/Azure_Public_Service_Icons/Icons/ai%20+%20machine%20learning/10165-icon-service-Bot-Services.svg;" vertex="1" parent="g-hosted">
          <mxGeometry x="30" y="730" width="580" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="g-merge1" value="Fusion typée + contrôles" style="text;html=0;align=right;fontSize=19;fontColor=#592C7A;" vertex="1" parent="g-hosted">
          <mxGeometry x="50" y="517" width="255" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="g-merge2" value="Fusion typée + contrôles" style="text;html=0;align=right;fontSize=19;fontColor=#592C7A;" vertex="1" parent="g-hosted">
          <mxGeometry x="50" y="682" width="255" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="g-final" value="5. Fusion + contrôles finaux → terminal&#10;derive_art_prompt(card) : fonction locale&#10;Seule sortie publique : carte + artPrompt&#10;ou arrêt structuré ; jamais de pixels" style="rounded=0;fillColor=#F0E4FA;strokeColor=#8651B0;fontColor=#38214B;fontSize=21;align=center;verticalAlign=middle;" vertex="1" parent="g-hosted">
          <mxGeometry x="30" y="890" width="580" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="g-host-note" value="3 agents internes séquentiels ≠ 3 services déployés" style="text;html=0;align=center;fontSize=20;fontColor=#592C7A;" vertex="1" parent="g-hosted">
          <mxGeometry x="30" y="1045" width="580" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="g-model-note" value="Agent = instructions + schéma + client&#10;Modèle = service d'inférence distant&#10;&#10;3 appels texte sur le parcours complet.&#10;Aucun appel modèle pour les fusions,&#10;le graphe ou derive_art_prompt()." style="text;html=0;align=center;fontSize=22;fontColor=#704913;" vertex="1" parent="g-models">
          <mxGeometry x="30" y="80" width="440" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="g-text-model" value="MODÈLE TEXTE&#10;gpt-5.5&#10;Déploiement : gpt-5-5&#10;&#10;Un même modèle partagé&#10;par les 3 spécialistes&#10;&#10;Réponses structurées JSON&#10;et filtrage côté modèle" style="shape=label;rounded=0;fillColor=#F8E3C6;strokeColor=#B07829;fontColor=#51370F;fontSize=23;align=center;verticalAlign=top;spacingTop=70;imageAlign=center;imageVerticalAlign=top;imageWidth=44;imageHeight=44;image=https://tomkiljo.github.io/ms-icons/icons/Azure_Public_Service_Icons/Icons/ai%20+%20machine%20learning/03438-icon-service-Azure-OpenAI.svg;" vertex="1" parent="g-models">
          <mxGeometry x="40" y="400" width="420" height="440" as="geometry"/>
        </mxCell>
        <mxCell id="g-image-model" value="MODÈLE IMAGE : gpt-image-2&#10;Texte seul ou texte + photo&#10;Base64 → PNG dans le backend WEB" style="shape=label;rounded=0;fillColor=#FBEACF;strokeColor=#B07829;fontColor=#51370F;fontSize=20;align=center;verticalAlign=top;spacingTop=52;imageAlign=center;imageVerticalAlign=top;imageWidth=34;imageHeight=34;image=https://tomkiljo.github.io/ms-icons/icons/Azure_Public_Service_Icons/Icons/ai%20+%20machine%20learning/03438-icon-service-Azure-OpenAI.svg;" vertex="1" parent="g-models">
          <mxGeometry x="40" y="870" width="420" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="g-blob" value="Blob Storage / card-assets&#10;Octets PNG privés&#10;Upload puis lecture par le proxy WEB" style="shape=label;rounded=0;fillColor=#D5EBD9;strokeColor=#4C8A59;fontColor=#213E27;fontSize=20;align=center;verticalAlign=top;spacingTop=42;imageAlign=center;imageVerticalAlign=top;imageWidth=32;imageHeight=32;image=https://tomkiljo.github.io/ms-icons/icons/Azure_Public_Service_Icons/Icons/storage/10086-icon-service-Storage-Accounts.svg;" vertex="1" parent="g-data">
          <mxGeometry x="30" y="90" width="390" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="g-cosmos" value="Cosmos DB&#10;Carte, métadonnées, réservations&#10;et audit opérationnel autorisé" style="shape=label;rounded=0;fillColor=#E2F0D9;strokeColor=#4C8A59;fontColor=#213E27;fontSize=20;align=center;verticalAlign=top;spacingTop=42;imageAlign=center;imageVerticalAlign=top;imageWidth=32;imageHeight=32;image=https://tomkiljo.github.io/ms-icons/icons/Azure_Public_Service_Icons/Icons/databases/10121-icon-service-Azure-Cosmos-DB.svg;" vertex="1" parent="g-data">
          <mxGeometry x="480" y="90" width="390" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="g-storage-note" value="Pas d'outil de stockage&#10;dans les agents.&#10;&#10;Entra et Application Insights :&#10;voir la vue infrastructure." style="text;html=0;align=center;fontSize=19;fontColor=#2C6337;" vertex="1" parent="g-data">
          <mxGeometry x="900" y="80" width="320" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="g-stop-note" value="Si HOSTED renvoie held / refused / une erreur : arrêt AVANT le modèle image. HTTP 200 du serveur agent ne signifie pas nécessairement succès métier." style="text;html=0;align=left;fontSize=22;fontStyle=1;fontColor=#8A382C;" vertex="1" parent="1">
          <mxGeometry x="40" y="1710" width="2260" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="g-footer" value="Vue logique du code, parcours initial réussi (pas une mesure live). Réponses HTTP implicites sauf retours orange ; variantes / retries détaillés dans la documentation." style="text;html=0;align=left;fontSize=20;fontColor=#42526E;" vertex="1" parent="1">
          <mxGeometry x="40" y="1765" width="2260" height="35" as="geometry"/>
        </mxCell>
